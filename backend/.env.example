# Copy this file to .env and fill in your local Postgres credentials

PGHOST=localhost
PGPORT=5432
PGDATABASE=hungryhub
PGUSER=postgres
PGPASSWORD=sunnyking

# Port the backend API server runs on
PORT=4000

# Origin of your Vite frontend (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Secret used to sign login JWTs — change this to any random string
JWT_SECRET=hungryhub_dev_secret_change_me
